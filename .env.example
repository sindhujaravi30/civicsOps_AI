APP_NAME=CivicOps AI
APP_VERSION=1.0.0
ENVIRONMENT=development

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

LLM_TIMEOUT_SECONDS=30
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/civicops
SYSTEM_PROMPT=You are CivicOps AI, a helpful government-service assistant. Answer clearly and concisely. Do not invent government policies, fees, deadlines, or personal data. If information is unavailable, say so explicitly.